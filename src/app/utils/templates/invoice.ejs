<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tour Booking Invoice</title>
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        padding: 40px;
        background-color: #f8f9fa;
        color: #333;
      }

      .invoice-container {
        background: #fff;
        border-radius: 8px;
        padding: 30px;
        max-width: 700px;
        margin: 0 auto;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }

      h1 {
        text-align: center;
        color: #007bff;
        margin-bottom: 30px;
      }

      .invoice-details p {
        margin: 8px 0;
        font-size: 15px;
      }

      .invoice-details p strong {
        width: 160px;
        display: inline-block;
      }

      .invoice-items {
        width: 100%;
        border-collapse: collapse;
        margin-top: 30px;
      }

      .invoice-items th,
      .invoice-items td {
        border: 1px solid #ddd;
        padding: 12px;
        text-align: left;
        font-size: 14px;
      }

      .invoice-items th {
        background-color: #007bff;
        color: white;
      }

      .footer {
        text-align: center;
        margin-top: 40px;
        font-size: 14px;
        color: #555;
      }

      .total-row {
        font-weight: bold;
        background-color: #f1f1f1;
      }
    </style>
  </head>
  <body>
    <div class="invoice-container">
      <h1>Tour Booking Invoice</h1>

      <div class="invoice-details">
        <p><strong>Booking Date:</strong> <%= bookingDate.toDateString() %></p>
        <p><strong>Guest Count:</strong> <%= guestCount %></p>
        <p><strong>Transaction ID:</strong> <%= transactionId %></p>
        <p><strong>Tour Title:</strong> <%= tourTitle %></p>
        <p><strong>Customer Name:</strong> <%= userName %></p>
      </div>

      <table class="invoice-items">
        <thead>
          <tr>
            <th>Description</th>
            <th>Guests</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Tour Booking</td>
            <td><%= guestCount %></td>
            <td>$<%= totalAmount.toFixed(2) %></td>
          </tr>
          <tr class="total-row">
            <td colspan="2">Total</td>
            <td>$<%= totalAmount.toFixed(2) %></td>
          </tr>
        </tbody>
      </table>

      <div class="footer">
        <p>Thank you for booking with us!</p>
        <p>Happy Journey 🌍</p>
      </div>
    </div>
  </body>
</html>
